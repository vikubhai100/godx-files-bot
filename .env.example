# Copy to .env for local dev — NEVER commit real values
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=your_bot_username
ADMIN_IDS=              # comma separated numeric ids (optional — /admin <secret> bootstrap works)
ADMIN_SECRET=change-me-bootstrap-secret

FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_B64=   # base64 of service-account JSON (recommended)
FIREBASE_SA_PATH=               # OR local path to serviceAccountKey.json

UPDATES_CHANNEL=your_channel_username   # optional: button URL on files (else first /addchannel channel)
OWNER_NAME=GOD X MODS
BOT_NAME=GOD X FILES

AUTO_DELETE_SECONDS=600
UPLOAD_RATE_LIMIT=10
OPEN_UPLOADS=0                  # 1 = anyone can host files (default admin-only)
PORT=8080
